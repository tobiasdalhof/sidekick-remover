{
  "manifest_version": 3,
  "name": "Sidekick Remover",
  "version": "0.1.0",
  "description": "Remove floating Sidekick chat bar from Shopify Admin.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sidekick-remover@tobiasdalhof.github.io",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Sidekick Remover",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
